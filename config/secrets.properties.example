# Copy this file to config/secrets.properties. Values do not need quotes.
# DEBUG_* is used by debug (com.whimo.dev); RELEASE_* by release (com.whimo).

DEBUG_MAPS_API_KEY=REPLACE_WITH_DEV_MAPS_API_KEY
DEBUG_GOOGLE_AUTH_CLIENT_ID=REPLACE_WITH_WEB_OAUTH_CLIENT_ID.apps.googleusercontent.com

RELEASE_MAPS_API_KEY=REPLACE_WITH_PROD_MAPS_API_KEY
RELEASE_GOOGLE_AUTH_CLIENT_ID=REPLACE_WITH_WEB_OAUTH_CLIENT_ID.apps.googleusercontent.com

# Optional legacy fields: the current captcha page owns the Turnstile sitekey.
# Android uses CAPTCHA_URL from config/build.properties instead.
# DEBUG_CAPTCHA_SITE_KEY=REPLACE_WITH_DEV_SITE_KEY
# RELEASE_CAPTCHA_SITE_KEY=REPLACE_WITH_PROD_SITE_KEY
